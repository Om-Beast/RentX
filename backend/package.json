    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.15.1",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35"
